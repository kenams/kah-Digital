    "lucide-react": "^1.9.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "openai": "^6.34.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
